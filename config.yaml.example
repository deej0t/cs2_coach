# CS2-Coach Konfiguration
# Kopiere diese Datei nach config.yaml und trage deine Werte ein.
# Docker: demo_folder auf /data/demos setzen, obsidian_vault_path auf /data/vault
ai_model: ''
ai_provider: ollama
coach_subfolder: CS2-Coach
cs2_auth_token: ''
demo_folder: ''
discord_webhook: ''
gemini_api_key: ''
language: de
obsidian_vault_path: ''
ollama_url: http://192.168.188.71:11434
player_name: ''
steam_api_key: ''
steam_id: ''
# Steam-Login fuer automatischen Demo-Download (optional)
# Wird benoetigt um Demos direkt von Valve-Servern herunterzuladen.
# Session-Cookies werden lokal gespeichert, Passwort wird NICHT dauerhaft gespeichert.
steam_username: ''

# Passwortschutz fuer die Web-UI (optional)
# Ist kein Passwort gesetzt, ist die App ohne Anmeldung erreichbar.
# Am einfachsten ueber Einstellungen -> Sicherheit setzen; der Hash landet dann hier.
# Alternativ per Umgebungsvariable CS2COACH_PASSWORD (hat Vorrang vor diesem Wert).
# auth:
#   password_hash: 'scrypt:32768:8:1$...'
