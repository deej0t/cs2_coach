# CS2-Coach Konfiguration
# Kopiere diese Datei nach config.yaml und trage deine Werte ein.
# Docker: demo_folder auf /data/demos setzen, obsidian_vault_path auf /data/vault
ai_model: ''
ai_provider: ollama
coach_subfolder: CS2-Coach
cs2_auth_token: ''
demo_folder: ''
discord_webhook: ''
gemini_api_key: ''
language: de
obsidian_vault_path: ''
ollama_url: http://localhost:11434
player_name: ''
steam_api_key: ''
steam_id: ''
# Steam-Login fuer automatischen Demo-Download (optional)
# Wird benoetigt um Demos direkt von Valve-Servern herunterzuladen.
# Session-Cookies werden lokal gespeichert, Passwort wird NICHT dauerhaft gespeichert.
steam_username: ''

# Systemstatus (optional)
# Adresse, unter der die WebUI aufgerufen wird. Der Systemstatus prueft sie
# von aussen; der Docker-Healthcheck fragt nur innerhalb des Containers und
# sieht eine falsche Portzuordnung nicht.
public_url: ''
# Eigener Webhook nur fuer Statusmeldungen. Leer = discord_webhook verwenden.
health_webhook: ''
# USV im Systemstatus: Adresse des NUT-Dienstes (Unraid: IP des Servers,
# Port 3493). Leer = keine Pruefung. ups_name nur, wenn die USV nicht "ups" heisst.
ups_host: ''
# Lebenszeichen an healthchecks.io (Ping-Adresse eines Checks, Intervall 30 Min).
# Bleibt es aus, alarmiert der Dienst; bei einem Fehler im Systemstatus sofort.
heartbeat_url: ''
# Taegliches Trainings-Briefing (Container: ab CS2COACH_BRIEFING_HOUR, Standard 17 Uhr).
# Eigener Webhook dafuer, leer = discord_webhook. Text von der KI (ai_provider).
briefing_webhook: ''
# Briefing zusaetzlich per Telegram: Bot bei @BotFather anlegen, Token hier,
# dem Bot einmal /start schicken. Die Chat-ID findet die App selbst.
telegram_bot_token: ''

# Eigener CS2-Server (Seite /server): Chat-Befehle wie !top beantwortet der
# Coach per RCON. Leer = keine Chat-Befehle. Port meist 27015.
server_rcon_host: ''
# Adresse fuer Mitspieler (Seite /server, Systemstatus prueft DNS + Erreichbarkeit).
server_address: ''
server_rcon_port: 27015
server_rcon_password: ''
# Duell-Training (!training <map> im Chat, nur steam_id oben + training_admins).
# Nur Maps aus dem Premier/FACEIT-Pool; leer = de_ancient, de_anubis, de_dust2,
# de_inferno, de_mirage, de_nuke, de_overpass, de_train.
training_maps: []
training_admins: []
# Befehl, der nach dem Training die normale Map zurueckholt (z. B. Workshop-Map).
server_restore_command: ''
# Spielende und "Spieler der Woche" nach Discord. Leer = discord_webhook.
server_webhook: ''

# Passwortschutz fuer die Web-UI (optional)
# Ist kein Passwort gesetzt, ist die App ohne Anmeldung erreichbar.
# Am einfachsten ueber Einstellungen -> Sicherheit setzen; der Hash landet dann hier.
# Alternativ per Umgebungsvariable CS2COACH_PASSWORD (hat Vorrang vor diesem Wert).
# auth:
#   password_hash: 'scrypt:32768:8:1$...'
